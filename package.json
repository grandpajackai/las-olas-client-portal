{
  "name": "las-olas-client-portal",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web --port 8081",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "api": "node server/index.mjs",
    "dev": "node scripts/dev.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test server/*.test.mjs scripts/*.test.mjs",
    "build:web": "expo export --platform web",
    "build:ios": "npx eas-cli@latest build --platform ios --profile preview",
    "build:android": "npx eas-cli@latest build --platform android --profile preview",
    "test:client": "node --test scripts/client-state.test.mjs",
    "test:api": "node --test server/*.test.mjs",
    "test:demo": "node --test scripts/demo-api.test.mjs",
    "preview:dev": "EXPO_PUBLIC_DEMO_MODE=true expo start --web --port 8082",
    "build:preview": "EXPO_PUBLIC_DEMO_MODE=true EXPO_PUBLIC_BASE_PATH=/las-olas-client-portal expo export --platform web --output-dir preview-dist && node scripts/prepare-preview.mjs"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.16",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "expo": "^57.0.27",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-image-picker": "~57.0.20",
    "expo-linear-gradient": "~57.0.2",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.22",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-native": "^0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "xcode": {
      "uuid": "11.1.1"
    }
  }
}
